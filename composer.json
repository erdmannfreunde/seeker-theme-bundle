{
  "name": "erdmannfreunde/seeker-theme-bundle",
  "type": "contao-bundle",
  "description": "Template- und Asset-Overrides für das SEEKER-Theme.",
  "keywords": [
    "contao",
    "contao theme",
    "career",
    "seeker",
    "plenta-jobs"
  ],
  "homepage": "https://www.flow-contao-themes.de/contao-themes/seeker",
  "license": "LGPL-3.0-or-later",
  "authors": [
    {
      "name": "Dennis Erdmann",
      "homepage": "https://erdmann-freunde.de"
    }
  ],
  "require": {
    "php": "^8.1",
    "contao/core-bundle": "^5.7",
    "contao/manager-plugin": "^2.0",
    "symfony/http-kernel": "^6.0 || ^7.0",
    "nutshell-framework/nutshell": "^2.0",
    "nutshell-framework/hero-element": "^1.0",
    "nutshell-framework/card-element": "^1.0",
    "erdmannfreunde/contao-grid-bundle": "^2.0",
    "plenta/contao-jobs-basic-bundle": "^3.1",
    "erdmannfreunde/theme-toolbox": "^4.3",
    "erdmannfreunde/contao-ping-bundle": "^1.0",
    "nutshell-framework/icon-picker": "^1.0",
    "nutshell-framework/contact-element": "^1.3",
    "nutshell-framework/core-bundle": "^0.2",
    "terminal42/contao-mp_forms": "^5.3"
