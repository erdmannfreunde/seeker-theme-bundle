{# *
 * Seeker — Stellen-Detailseite (Plenta Reader Override)
 *
 * Vollständiges Section-Layout anhand des Seeker-Prototypes:
 *   Back → Hero (Headline + Meta-Karte) → Inhaltselemente der Stelle
 *   (Aufgaben, Profil und „Wir bieten“ als Elemente „Liste“)
 *
 * Kontakt + Apply-CTA sind theme-global und kommen NICHT aus dem Reader —
 * sie werden via CE `contact` als zweiter Artikel auf der Reader-Seite
 * platziert.
 *
 * Verfügbare Twig-Variablen (vom JobOfferReaderController gesetzt):
 *   jobOffer       — PlentaJobsBasicOfferModel mit allen DCA-Feldern inkl.
 *                    flowDept, flowRemote
 *   jobOfferMeta   — Array mit aufbereiteten Werten: title, teaser, description,
 *                    employmentTypeFormatted, locationFormatted,
 *                    publicationDateFormatted, image, alias
 *
 * Im Reader-Modul ist unter „Template-Teile“ nur „Inhaltselemente“
 * (`elements`) aktiv: Der Controller rendert dann ausschließlich die
 * Inhaltselemente der Stelle in `content`, alle übrigen Felder kommen
 * direkt aus jobOffer/jobOfferMeta.
 *
 * Texte kommen aus contao/languages/{de,en}/default.xlf (MSC.seeker_job_*). * #}

{% trans_default_domain 'contao_default' %}
{% extends '@Contao/frontend_module/_base.html.twig' %}

{% block content %}
    {# data-job-alias: Alias der Stelle (bei Übersetzungen der übersetzte) für
       apply-cta.js, das ihn an die Bewerben-Buttons außerhalb des Readers
       (CE `contact`) als ?stelle= anhängt. #}
    <div class="job-detail" data-job-alias="{{ jobOfferMeta.alias }}">

        {# ─── BACK-LINK ────────────────────────────────────────────────── #}
        {# Übergeordnete Seite der Detailseite, in der Demo die Stellenliste.
           Plentas „referer“ ist immer history.go(-1) und führt Besucher:innen
           von Google zurück zur Suche. #}
        <p class="job-detail__back">
            <a href="{{ insert_tag('link_url::' ~ insert_tag('page::pid')) }}">
                <span class="job-detail__back-icon" aria-hidden="true"></span>
                {{ 'MSC.seeker_job_back'|trans }}
            </a>
        </p>

        {# ─── HERO ────────────────────────────────────────────────────── #}
        <section class="job-detail__hero">
            <div class="job-detail__hero-content">
                {% if jobOffer.flowDept %}
                    <span class="job-detail__eyebrow">{{ jobOffer.flowDept }}</span>
                {% endif %}
                <h1 class="job-detail__title">{{ jobOfferMeta.title }}</h1>
                {% if jobOfferMeta.teaser %}
                    <div class="job-detail__lead">{{ jobOfferMeta.teaser|raw }}</div>
                {% endif %}
                <div class="job-detail__hero-actions">
                    {# Bewerbungsseite = Weiterleitungsseite (jumpTo) des Reader-Moduls;
                       Plenta selbst nutzt jumpTo beim Reader nicht. #}
                    {% if data.jumpTo %}
                        <a href="{{ insert_tag('link_url::' ~ data.jumpTo) }}?stelle={{ jobOfferMeta.alias }}">{{ 'MSC.seeker_job_apply'|trans }}</a>
                    {% endif %}
                    <a href="mailto:?subject={{ jobOfferMeta.title|input_encoded_to_plain_text|url_encode }}&amp;body={{ (insert_tag('env::url') ~ '/' ~ insert_tag('env::request'))|url_encode }}" class="btn--secondary">{{ 'MSC.seeker_job_share'|trans }}</a>
                </div>
            </div>

            <aside class="job-detail__meta" aria-label="{{ 'MSC.seeker_job_facts'|trans }}">
                <div class="job-detail__meta-eyebrow">{{ 'MSC.seeker_job_facts'|trans }}</div>
                <dl class="job-detail__meta-list">
                    {% if jobOfferMeta.locationFormatted %}
                        <div class="job-detail__meta-row">
                            <dt>{{ 'MSC.seeker_job_location'|trans }}</dt>
                            <dd>{{ jobOfferMeta.locationFormatted }}</dd>
                        </div>
                    {% endif %}
                    {% if jobOfferMeta.employmentTypeFormatted %}
                        <div class="job-detail__meta-row">
                            <dt>{{ 'MSC.seeker_job_employment_type'|trans }}</dt>
                            <dd>{{ jobOfferMeta.employmentTypeFormatted }}</dd>
                        </div>
                    {% endif %}
                    {% if jobOffer.flowDept %}
                        <div class="job-detail__meta-row">
                            <dt>{{ 'MSC.seeker_job_department'|trans }}</dt>
                            <dd>{{ jobOffer.flowDept }}</dd>
                        </div>
                    {% endif %}
                    {% if jobOfferMeta.publicationDateFormatted %}
                        <div class="job-detail__meta-row">
                            <dt>{{ 'MSC.seeker_job_published'|trans }}</dt>
                            <dd>{{ jobOfferMeta.publicationDateFormatted }}</dd>
                        </div>
                    {% endif %}
                    {% set salary = seeker_job_salary(jobOffer) %}
                    {% if salary %}
                        <div class="job-detail__meta-row">
                            <dt>{{ 'MSC.seeker_job_salary'|trans }}</dt>
                            <dd>{{ salary }}</dd>
                        </div>
                    {% endif %}
                    {% if jobOffer.flowRemote %}
                        <div class="job-detail__meta-row job-detail__meta-row--last">
                            <dt>{{ 'MSC.seeker_job_remote'|trans }}</dt>
                            <dd>{{ jobOffer.flowRemote }}</dd>
                        </div>
                    {% endif %}
                </dl>
            </aside>
        </section>

        {# ─── INHALTSELEMENTE DER STELLE ──────────────────────────────── #}
        {% if content|default %}
        <div class="job-detail__elements">
            {{ content|raw }}
        </div>
        {% endif %}

    </div>
{% endblock %}
