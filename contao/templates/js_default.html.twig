{#
  Seeker — Theme-Skripte.
  Lädt die Skripte aus layout/seeker-theme/js/ am Ende der Seite. Die Theme
  Toolbox kopiert sie nach /assets/seeker-theme/js/ (ohne Node), theme_js()
  löst den Pfad auf und hängt den Cache-Busting-Parameter an. Alle weiteren
  js_*-Templates können danach auf die Theme-Helfer (z. B. NavMobile)
  zugreifen.

  Im Debug-Modus kommt das Bundle des Webpack-Dev-Servers dazu, falls
  vorhanden: Es bringt den HMR-/Reload-Client mit.
#}
{% set scripts = ['navigation.js', 'apply-cta.js', 'job-filter.js', 'forms.js'] %}

{% if app.debug %}
  {% set scripts = scripts|merge(['default.bundle.js']) %}
{% endif %}

{% for script in scripts %}
  {% set src = theme_js(script) %}

  {% if src %}
    <script src="{{ src }}"></script>
  {% endif %}
{% endfor %}
