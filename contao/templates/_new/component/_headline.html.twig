{#
    Override des Contao-Headline-Components: ergänzt eine optionale Dachzeile
    (Supline / Eyebrow), die vom `nutshell-framework/core-bundle` als DCA-Feld
    an `headline`- und `text`-CEs eingehängt wird (`data.supline`, plain text).

    Wenn eine Dachzeile gesetzt ist, wird sie INNERHALB der Headline ausgegeben:

        <h2>
            <span class="headline__supline">…</span>
            <span class="headline__separator">: </span>
            <span class="headline__main">…</span>
        </h2>

    Der Separator steht bewusst als sichtbares Markup im DOM, damit
    Screenreader den Trenner zwischen Dachzeile und Haupt-Überschrift
    mitlesen. Visuell blendet das Theme ihn via SCSS aus.

    Wichtig: Das Original aus `@Contao/component/_headline.html.twig` ist ein
    Trait (`{% use ... %}` in `_base.html.twig`). Daher KEIN `extends` —
    wir definieren `headline_component` neu und reproduzieren das Default-
    Markup inkl. Supline-Erweiterung.
#}

{% block headline_component %}
    {% set headline = headline|default(_context) %}
    {% set tag_name = headline.tag_name|default('h1') %}
    {% set supline  = data.supline|default('') %}

    <{{ tag_name }}{% block headline_attributes %}{{ headline.attributes|default }}{% endblock %}>
    {%- block headline_inner -%}
        {% if supline %}
            <span class="headline__supline">{{ supline|insert_tag_raw }}</span>
            <span class="headline__separator">: </span>
            <span class="headline__main">{{ headline.text|insert_tag_raw }}</span>
        {% else %}
            {{ headline.text|insert_tag_raw }}
        {% endif %}
    {%- endblock -%}
    </{{ tag_name }}>
{% endblock %}
