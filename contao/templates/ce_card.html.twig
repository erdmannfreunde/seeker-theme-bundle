{#
  Seeker-Theme — Override des card-element-Bundles.

  Erweitert das Default-Template um den Icon-Branch: ist `inlineSvg` (UUID)
  gesetzt, wird das SVG inline ins .card__image gerendert. Ansonsten bleibt
  das normale Bild-Verhalten wie im Bundle-Default.
#}

{% set hasImage = addCardImage and picture is defined %}
{% set hasIcon  = addIcon|default(false) and inlineSvg|default(false) %}

<div class="{{ class }} block"{{ cssID|raw }}{% if style %} style="{{ style }}"{% endif %}>
  {% if hasIcon %}
    <figure class="card__image card__image--icon">
      {{ inline_icon(inlineSvg, 'card__icon-svg') }}
    </figure>
  {% elseif hasImage %}
    <figure class="card__image">
      {{ include('@Contao/picture_default.html.twig', picture, false) }}

      {% if caption ?? false %}
        <figcaption class="caption">{{ caption }}</figcaption>
      {% endif %}
    </figure>
  {% endif %}

  {% if addText or headline %}
    <div class="card__content">
      {% if headline %}
        <{{ hl }} class="card__headline">{{ headline|insert_tag_raw }}</{{ hl }}>
      {% endif %}

      {% if addText %}
        <div class="card__description">{{ text|insert_tag_raw|raw }}</div>
      {% endif %}

      {% if url %}
        <div class="card__link">
          <a href="{{ href|insert_tag }}" title="{{ linkTitle ?? '' }}"{{ (rel ?? '')|raw }}{{ (target ?? '')|raw }}>{{ link|insert_tag }}</a>
        </div>
      {% endif %}
    </div>
  {% endif %}
</div>
