{#
  Seeker — Seiten-Template.

  Bindet das Theme-CSS über das Encore-Manifest ein: asset() löst
  `theme/default.css` über framework.assets.json_manifest_path auf
  (config/config.yaml, wie alarm-as). `npm run build`/`dev` liefern
  /theme/css/default.css, `npm run dev-server` dank --keep-public-path und
  writeToDisk ebenfalls.
#}
{% extends '@Contao/fe_page' %}

{% block head %}
    {{ parent() }}

    <link rel="stylesheet" href="{{ asset('theme/default.css') }}">
{% endblock %}
